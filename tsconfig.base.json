{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@finance-design/tokens": ["packages/tokens/src/index.ts"],
      "@finance-design/styles": ["packages/styles/src/index.ts"],
      "@finance-design/design-system": ["packages/components/src/index.ts"],
      "@finance-design/design-system/*": ["packages/components/src/*.ts"]
    }
  }
}
