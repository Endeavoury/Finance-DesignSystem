{
  "name": "@endeavoury/kanosis-tokens",
  "version": "1.0.2",
  "description": "Semantic design tokens for Kanosis products.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endeavoury/Kanosis.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "build": "tsc -b && cp src/tokens.css dist/tokens.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
