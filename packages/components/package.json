{
  "name": "@endeavoury/kanosis",
  "version": "1.0.2",
  "description": "Framework-independent Kanosis Web Components built with Lit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endeavoury/Kanosis.git",
    "directory": "packages/components"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/register/*.js"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./classes": {
      "types": "./dist/classes.d.ts",
      "import": "./dist/classes.js"
    },
    "./button": {
      "types": "./dist/register/button.d.ts",
      "import": "./dist/register/button.js"
    },
    "./forms": {
      "types": "./dist/register/forms.d.ts",
      "import": "./dist/register/forms.js"
    },
    "./secondary-forms": {
      "types": "./dist/register/secondary-forms.d.ts",
      "import": "./dist/register/secondary-forms.js"
    },
    "./display": {
      "types": "./dist/register/display.d.ts",
      "import": "./dist/register/display.js"
    },
    "./feedback": {
      "types": "./dist/register/feedback.d.ts",
      "import": "./dist/register/feedback.js"
    },
    "./interaction": {
      "types": "./dist/register/interaction.d.ts",
      "import": "./dist/register/interaction.js"
    },
    "./overlays": {
      "types": "./dist/register/overlays.d.ts",
      "import": "./dist/register/overlays.js"
    },
    "./upload": {
      "types": "./dist/register/upload.d.ts",
      "import": "./dist/register/upload.js"
    },
    "./data-table": {
      "types": "./dist/register/data-table.d.ts",
      "import": "./dist/register/data-table.js"
    },
    "./layout": {
      "types": "./dist/register/layout.d.ts",
      "import": "./dist/register/layout.js"
    },
    "./navigation": {
      "types": "./dist/register/navigation.d.ts",
      "import": "./dist/register/navigation.js"
    },
    "./navigation-extras": {
      "types": "./dist/register/navigation-extras.d.ts",
      "import": "./dist/register/navigation-extras.js"
    },
    "./patterns": {
      "types": "./dist/register/patterns.d.ts",
      "import": "./dist/register/patterns.js"
    },
    "./tree": {
      "types": "./dist/register/tree.d.ts",
      "import": "./dist/register/tree.js"
    }
  },
  "scripts": {
    "build": "tsc -b && cp ../styles/src/global.css dist/styles.css"
  },
  "dependencies": {
    "@endeavoury/kanosis-styles": "1.0.2",
    "@endeavoury/kanosis-tokens": "1.0.2",
    "lit": "3.3.3",
    "tslib": "2.8.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
