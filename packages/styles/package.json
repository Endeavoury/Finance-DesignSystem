{
  "name": "@endeavoury/finance-design-styles",
  "version": "0.1.0",
  "description": "Shared styling foundations and opt-in global styles for Finance Design.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Endeavoury/Finance-DesignSystem.git",
    "directory": "packages/styles"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./global.css": "./dist/global.css"
  },
  "scripts": {
    "build": "tsc -b && cp src/global.css dist/global.css"
  },
  "dependencies": {
    "@endeavoury/finance-design-tokens": "0.1.0",
    "lit": "3.3.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
